<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FFFB">

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp">

                <!-- CAMPUSLINK LOGO -->
                <LinearLayout
                    android:id="@+id/logoArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_logo_circle" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CampusLink"
                            android:textColor="#07133F"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Multi-University Ecosystem"
                            android:textColor="#159447"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- NOTIFICATION -->
                <FrameLayout
                    android:id="@+id/notificationButton"
                    android:layout_width="50dp"
                    android:layout_height="60dp"
                    android:layout_toStartOf="@id/btnLogout"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="♧"
                        android:textColor="#07133F"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:gravity="center"
                        android:text="89"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_notification" />

                </FrameLayout>

                <!-- LOGOUT -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="120dp"
                    android:layout_height="52dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Logout"
                    android:textColor="#159447"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="30dp"
                    app:strokeColor="#159447"
                    app:strokeWidth="2dp"
                    app:backgroundTint="#FFFFFF" />

            </RelativeLayout>


            <!-- SEARCH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="15dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#079A48"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search products, services, offers..."
                    android:textColorHint="#7B86A8"
                    android:paddingStart="10dp"
                    android:textColor="#07133F"
                    android:textSize="18sp"
                    android:singleLine="true" />

            </LinearLayout>


            <!-- CATEGORIES TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_green_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="Categories"
                    android:textColor="#07133F"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- CATEGORY ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- BUY AND SELL -->
                <LinearLayout
                    android:id="@+id/categoryBuySell"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:gravity="center"
                        android:text="🛒"
                        android:textSize="38sp"
                        android:background="@drawable/bg_category_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Buy &amp; Sell"
                        android:textColor="#07133F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ADVERTISE -->
                <LinearLayout
                    android:id="@+id/categoryAdvertise"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:gravity="center"
                        android:text="📣"
                        android:textSize="36sp"
                        android:background="@drawable/bg_category_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Advertise"
                        android:textColor="#07133F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- SERVICES -->
                <LinearLayout
                    android:id="@+id/categoryServices"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:gravity="center"
                        android:text="🛠"
                        android:textSize="36sp"
                        android:background="@drawable/bg_category_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Services"
                        android:textColor="#07133F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- CONNECT -->
                <LinearLayout
                    android:id="@+id/categoryConnect"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:gravity="center"
                        android:text="📶"
                        android:textSize="36sp"
                        android:background="@drawable/bg_category_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Connect"
                        android:textColor="#07133F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- POST BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPost"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:text="+   Post Product / Service     ›"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:backgroundTint="#10C83A"
                app:elevation="5dp" />


            <!-- RECENT LISTINGS TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_green_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="Recent Campus Listings"
                    android:textColor="#07133F"
                    android:textSize="27sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ROTATING BANNER -->
            <ViewFlipper
                android:id="@+id/bannerFlipper"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:autoStart="true"
                android:flipInterval="3500"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out">

                <!-- BANNER 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:background="@drawable/bg_banner">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome to"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multi-University"
                        android:textColor="#52FF19"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CampusLink!"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Browse • Connect • Trade • Grow"
                        android:textColor="#DFFFF0"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- BANNER 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="25dp"
                    android:background="@drawable/bg_banner_two">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buy &amp; Sell"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find products around your campus"
                        android:textColor="#E0FFE9"
                        android:textSize="16sp" />

                </LinearLayout>


                <!-- BANNER 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="25dp"
                    android:background="@drawable/bg_banner_three">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grow Your Business"
                        android:textColor="#FFFFFF"
                        android:textSize="31sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advertise your products and services"
                        android:textColor="#E0FFE9"
                        android:textSize="16sp" />

                </LinearLayout>

            </ViewFlipper>

            <!-- SUPABASE LISTINGS -->
            <LinearLayout
                android:id="@+id/listingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />


            <!-- FOOTER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="Developed by Cherry • All Rights Reserved"
                android:textColor="#536B9D"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="#005C32"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="12dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#5BFF57"
                android:textSize="31sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#5BFF57"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- CATEGORIES -->
        <LinearLayout
            android:id="@+id/navCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- CENTER POST -->
        <FrameLayout
            android:id="@+id/navPost"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="-22dp"
            android:background="@drawable/bg_post_circle"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="42sp" />

        </FrameLayout>


        <!-- MESSAGES -->
        <LinearLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▢"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>