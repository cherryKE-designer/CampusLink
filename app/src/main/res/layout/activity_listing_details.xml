<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FFFB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="← Back"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↗ Share"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Listing Image Gallery -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/listingImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#E8F5E9"
                android:contentDescription="Listing product image" />

            <TextView
                android:id="@+id/btnPreviousImage"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#88000000"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNextImage"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="›"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#88000000"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/imageCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="1 / 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#99000000" />

        </FrameLayout>

        <!-- Category -->
        <TextView
            android:id="@+id/listingCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📦 Other"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:background="#E8F5E9"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp" />

        <!-- Listing Title -->
        <TextView
            android:id="@+id/listingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Listing Title"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#12372A" />

        <!-- Price -->
        <TextView
            android:id="@+id/listingPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="KSh 0"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <!-- Location -->
        <TextView
            android:id="@+id/listingLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="📍 Location"
            android:textSize="16sp"
            android:textColor="#555555" />

        <!-- Seller -->
        <TextView
            android:id="@+id/listingSeller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="👤 Posted by: Seller"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#12372A" />

        <!-- Seller Phone -->
        <TextView
            android:id="@+id/listingPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📱 Phone: Not provided"
            android:textSize="15sp"
            android:textColor="#555555" />

        <!-- Listing Status -->
        <TextView
            android:id="@+id/listingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="● Active"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <!-- Description Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Description"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#12372A" />

        <!-- Listing Description -->
        <TextView
            android:id="@+id/listingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Description"
            android:textSize="16sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp" />

        <!-- In-App Messaging -->
        <Button
            android:id="@+id/btnMessageSeller"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="✉ Message Seller"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#12372A" />

        <!-- WhatsApp Contact -->
        <Button
            android:id="@+id/btnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="💬 Contact Seller on WhatsApp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#25D366" />

        <!-- Call Seller -->
        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="📞 Call Seller"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#1B5E20" />

        <!-- Bottom Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="25dp" />

    </LinearLayout>

</ScrollView>
