<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================== -->
    <!-- INTERNET ACCESS                                       -->
    <!-- Supabase, images and APIs                             -->
    <!-- ===================================================== -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ===================================================== -->
    <!-- IMAGE / GALLERY ACCESS                                -->
    <!-- ===================================================== -->

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusLink"
        android:enableOnBackInvokedCallback="true">

        <!-- ================================================= -->
        <!-- PROFILE                                           -->
        <!-- ================================================= -->

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- POST PRODUCT / SERVICE                            -->
        <!-- ================================================= -->

        <activity
            android:name=".PostListingActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- MY LISTINGS                                       -->
        <!-- ================================================= -->

        <activity
            android:name=".MyListingsActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- LISTING DETAILS                                   -->
        <!-- ================================================= -->

        <activity
            android:name=".ListingDetailsActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- DASHBOARD                                         -->
        <!-- ================================================= -->

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- LOGIN                                             -->
        <!-- ================================================= -->

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- REGISTER                                           -->
        <!-- ================================================= -->

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- MAIN / LAUNCHER                                   -->
        <!-- ================================================= -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>
        <activity
            android:name=".CategorySelectionActivity"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- MESSAGES & CHAT                                   -->
        <!-- ================================================= -->

        <activity
            android:name=".MessagesInboxActivity"
            android:exported="false" />

        <activity
            android:name=".ChatActivity"
            android:exported="false" />
    </application>

</manifest>